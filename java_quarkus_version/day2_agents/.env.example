# Copia questo file come .env e compila i valori.
# Quarkus legge automaticamente le variabili d'ambiente.

# Modalita' LLM: mock | gemini_free | vertex
AGENT_LLM_MODE=mock

# API Key per Google Gemini (obbligatoria solo per gemini_free)
GOOGLE_API_KEY=

# Progetto Google Cloud (solo per vertex)
GOOGLE_CLOUD_PROJECT=
