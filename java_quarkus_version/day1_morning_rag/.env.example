# =============================================================
# Variabili d'ambiente per il progetto Day 1 RAG (Quarkus)
# =============================================================
# Copia questo file come .env e modifica i valori.
# Quarkus legge le variabili d'ambiente che sovrascrivono
# i valori in application.properties.
# =============================================================

# Modalita' LLM: mock | gemini_free | vertex
RAG_LLM_MODE=mock

# Gemini Free API (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_api_key_here

# Vertex AI (opzionale, richiede GCP)
GOOGLE_CLOUD_PROJECT=your_project_id_here
GOOGLE_CLOUD_LOCATION=us-east1
GOOGLE_APPLICATION_CREDENTIALS=./service_account.json
